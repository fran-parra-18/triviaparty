# ─────────────────────────────────────────────────────────────
# Trivia Party — variables de entorno
# Copia este archivo como `server/.env` (o `.env` en la raíz) y ajusta los valores.
# Ninguna variable es obligatoria en desarrollo: todas tienen valores por defecto.
# ─────────────────────────────────────────────────────────────

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP del servidor (API + Socket.IO + cliente compilado en producción).
PORT=3001

# Solo desarrollo: puerto del servidor que usa `npm run dev` (tiene prioridad sobre PORT).
# SERVER_PORT=3001

# Interfaz de red. 0.0.0.0 = accesible desde otros dispositivos de la red.
HOST=0.0.0.0

# Base de datos.
#  · SQLite (por defecto, sin instalación). Ruta relativa a server/prisma/:
DATABASE_URL="file:./trivia.db"
#  · PostgreSQL (producción). El proyecto detecta el prefijo y usa prisma/postgres/schema.prisma:
# DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/trivia?schema=public"

# URL pública que se codifica en el QR y se muestra en pantalla.
# Déjala vacía en desarrollo: se detecta la IP de la red local automáticamente.
# En Internet: la URL de tu dominio, p. ej. https://trivia.midominio.com
PUBLIC_URL=

# Solo desarrollo: puerto donde corre Vite, para que el QR apunte al cliente de desarrollo.
CLIENT_DEV_PORT=5173

# Orígenes permitidos para Socket.IO/API (separados por coma). Vacío = mismo origen + red local.
CORS_ORIGINS=

# Tiempo (minutos) que se conserva una sala si el anfitrión se desconecta.
HOST_GRACE_MINUTES=10

# Tiempo (minutos) de inactividad tras el que se elimina una sala.
ROOM_IDLE_MINUTES=120

# Límite absoluto de jugadores por sala (el anfitrión puede configurar uno menor).
MAX_PLAYERS_HARD_LIMIT=100

# Límite de salas activas simultáneas en el servidor.
MAX_ROOMS=500

# Si está detrás de un proxy inverso (Nginx, Render, Railway, Fly…), pon 1 para usar X-Forwarded-For.
TRUST_PROXY=0
